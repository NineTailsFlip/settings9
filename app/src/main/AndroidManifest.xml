<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Settings is signed with the platform key and installed as a privileged app (the thor2
         image: android_vendor_thor2's apps/), so it holds what it declares below; the privileged
         ones are also in the image's privapp-permissions-nine-settings.xml. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.CHANGE_CONFIGURATION" />
    <uses-permission android:name="android.permission.SET_TIME" />
    <uses-permission android:name="android.permission.SET_TIME_ZONE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.NETWORK_SETTINGS" />
    <uses-permission android:name="android.permission.NETWORK_AIRPLANE_MODE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_KEYGUARD_SECURE_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.MODIFY_DAY_NIGHT_MODE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <uses-permission android:name="android.permission.POWER_SAVER" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <uses-permission android:name="android.permission.CLEAR_APP_USER_DATA" />
    <uses-permission android:name="android.permission.DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
    <uses-permission android:name="android.permission.MANAGE_ROLE_HOLDERS" />
    <uses-permission android:name="android.permission.GRANT_RUNTIME_PERMISSIONS" />
    <uses-permission android:name="android.permission.MASTER_CLEAR" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS_PRIVILEGED" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- The shade: its own notification access, and the music's media session. -->
    <uses-permission android:name="android.permission.MANAGE_NOTIFICATION_LISTENERS" />
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />

    <!-- The status bar: its window over SystemUI's, and SystemUI's own icons off meanwhile. -->
    <uses-permission android:name="android.permission.STATUS_BAR_SERVICE" />
    <uses-permission android:name="android.permission.STATUS_BAR" />

    <!-- :update is only here for SetupChoices: Settings is part of the image and is updated with
         it, never on its own. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <application
        android:name=".SettingsApp"
        android:label="Settings"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/Theme.Nine">

        <!-- Every page. The launcher entry, and every android.settings.* page these Settings have
             (Screens.ACTIONS), at a priority above the stock app's (1), so they open here. -->
        <activity
            android:name=".ScreenActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:priority="10">
                <action android:name="android.settings.SETTINGS" />
                <action android:name="android.settings.WIRELESS_SETTINGS" />
                <action android:name="android.settings.AIRPLANE_MODE_SETTINGS" />
                <action android:name="android.settings.WIFI_SETTINGS" />
                <action android:name="android.settings.WIFI_IP_SETTINGS" />
                <action android:name="android.settings.DATA_ROAMING_SETTINGS" />
                <action android:name="android.settings.NETWORK_OPERATOR_SETTINGS" />
                <action android:name="android.settings.BLUETOOTH_SETTINGS" />
                <action android:name="android.settings.APPLICATION_SETTINGS" />
                <action android:name="android.settings.MANAGE_APPLICATIONS_SETTINGS" />
                <action android:name="android.settings.MANAGE_ALL_APPLICATIONS_SETTINGS" />
                <action android:name="android.settings.APP_NOTIFICATION_SETTINGS" />
                <action android:name="android.settings.MANAGE_DEFAULT_APPS_SETTINGS" />
                <action android:name="android.settings.ALL_APPS_NOTIFICATION_SETTINGS" />
                <action android:name="android.settings.ZEN_MODE_SETTINGS" />
                <action android:name="android.settings.SOUND_SETTINGS" />
                <action android:name="android.settings.DISPLAY_SETTINGS" />
                <action android:name="android.settings.DARK_THEME_SETTINGS" />
                <action android:name="android.settings.BATTERY_SAVER_SETTINGS" />
                <action android:name="android.intent.action.POWER_USAGE_SUMMARY" />
                <action android:name="android.settings.INTERNAL_STORAGE_SETTINGS" />
                <action android:name="android.settings.MEMORY_CARD_SETTINGS" />
                <action android:name="android.settings.SECURITY_SETTINGS" />
                <action android:name="android.settings.LOCK_SCREEN_SETTINGS" />
                <action android:name="android.settings.PRIVACY_SETTINGS" />
                <action android:name="android.settings.LOCATION_SOURCE_SETTINGS" />
                <action android:name="android.settings.SYNC_SETTINGS" />
                <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
                <action android:name="android.settings.LOCALE_SETTINGS" />
                <action android:name="android.settings.LANGUAGE_SETTINGS" />
                <action android:name="android.settings.INPUT_METHOD_SETTINGS" />
                <action android:name="android.settings.HARD_KEYBOARD_SETTINGS" />
                <action android:name="android.settings.DATE_SETTINGS" />
                <action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" />
                <action android:name="android.settings.DEVICE_INFO_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter android:priority="10">
                <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="package" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LookActivity"
            android:exported="false" />

        <!-- The notification shade and quick settings. The system starts it in place of SystemUI's
             panel (android_vendor_thor2's patch 0010, ro.config.thor2_shade), as system_server,
             so it needn't be exported. A panel of its own: its own task, never in Recents. -->
        <activity
            android:name=".ShadeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="io.github.ninetailsflip.settings.shade"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- The status bar. The system binds it from boot, before the first unlock too
             (android_vendor_thor2's patch 0011, ro.config.thor2_statusbar); nobody else may. -->
        <service
            android:name=".StatusBarService"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.STATUS_BAR_SERVICE" />

        <service
            android:name=".ShadeListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name="io.github.ninetailsflip.update.UpdateActivity"
            tools:node="remove" />
    </application>
</manifest>
